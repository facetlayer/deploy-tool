# deploy-server environment file.
#
# Install as /root/secrets/deploy.env, root-owned, mode 0600. Created by hand
# over SSH; never committed, never in a deploy bundle:
#
#   install -m 600 /dev/null /root/secrets/deploy.env
#   vi /root/secrets/deploy.env
#
# Pulled in by the unit with EnvironmentFile=. Values are read literally by
# systemd -- no shell, no quotes needed, no expansion.

# --- auth-center -----------------------------------------------------------
# Base URL of auth-center. NEVER hardcoded in the binary: do2 and dohl each get
# their own setting and their own service key so they revoke independently.
# Leave unset (or empty) for a legacy-only instance: no network calls, and the
# resource model is not enforced. That is rollout step 1.
#DEPLOY_AUTH_URL=https://auth.apf1.dev

# This instance's own auth-center service key. Must hold `auth:introspect`.
# Required whenever DEPLOY_AUTH_URL is set. This is the secret that makes this
# file 0600.
#DEPLOY_AUTH_KEY=

# The resource naming THIS INSTANCE's administration, e.g. deploy-do2 or
# deploy-dohl. `createProject` is checked against
# deploy:<this value>:create-project. Required whenever DEPLOY_AUTH_URL is set;
# there is deliberately no default and no derivation from the hostname, so an
# instance that forgets it refuses createProject rather than falling back to
# something guessable.
#DEPLOY_ADMIN_RESOURCE=deploy-do2

# --- legacy keys -----------------------------------------------------------
# The local secret_key table is checked first and grants every action on the
# instance. Set to 1 only once `deploy-server list-legacy-keys` reports that
# none remain. Rollout step 5, per instance.
#DEPLOY_DISABLE_LEGACY_KEYS=1

# --- storage ---------------------------------------------------------------
# Overrides where db.sqlite lives. Unset on do2/dohl: running as root with
# neither this nor XDG_STATE_HOME set resolves to
# /root/.local/state/deploy/db.sqlite, the database the old server already
# wrote and this one opens in place. Only set it to move an instance.
#DEPLOY_STATE_DIR=/root/.local/state/deploy
